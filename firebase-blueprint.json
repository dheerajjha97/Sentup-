{
  "entities": {
    "InterSentUpMarks": {
      "title": "InterSentUpMarks",
      "description": "Official 30-column BSEB Intermediate (+2) Sent-Up Exam marks map",
      "type": "object",
      "properties": {
        "lang1Subject": { "type": "string", "maxLength": 64 },
        "lang1Marks": { "type": "string", "maxLength": 16 },
        "lang2Subject": { "type": "string", "maxLength": 64 },
        "lang2Marks": { "type": "string", "maxLength": 16 },
        "elective1Subject": { "type": "string", "maxLength": 64 },
        "elective1Theory": { "type": "string", "maxLength": 16 },
        "elective1Practical": { "type": "string", "maxLength": 16 },
        "elective2Subject": { "type": "string", "maxLength": 64 },
        "elective2Theory": { "type": "string", "maxLength": 16 },
        "elective2Practical": { "type": "string", "maxLength": 16 },
        "elective3Subject": { "type": "string", "maxLength": 64 },
        "elective3Theory": { "type": "string", "maxLength": 16 },
        "elective3Practical": { "type": "string", "maxLength": 16 },
        "additionalSubject": { "type": "string", "maxLength": 64 },
        "additionalTheory": { "type": "string", "maxLength": 16 },
        "additionalPractical": { "type": "string", "maxLength": 16 },
        "vocationalSubject": { "type": "string", "maxLength": 64 },
        "vocationalTheory": { "type": "string", "maxLength": 16 },
        "vocationalPractical": { "type": "string", "maxLength": 16 },
        "resultStatus": { "type": "string", "maxLength": 32 }
      },
      "required": [
        "lang1Subject",
        "lang1Marks",
        "lang2Subject",
        "lang2Marks",
        "elective1Subject",
        "elective1Theory",
        "elective1Practical",
        "elective2Subject",
        "elective2Theory",
        "elective2Practical",
        "elective3Subject",
        "elective3Theory",
        "elective3Practical",
        "additionalSubject",
        "additionalTheory",
        "additionalPractical",
        "vocationalSubject",
        "vocationalTheory",
        "vocationalPractical",
        "resultStatus"
      ]
    },
    "MatricSentUpMarks": {
      "title": "MatricSentUpMarks",
      "description": "Official 23-column BSEB Matric (10th) Sent-Up Exam marks map",
      "type": "object",
      "properties": {
        "milTheory": { "type": "string", "maxLength": 16 },
        "silTheory": { "type": "string", "maxLength": 16 },
        "matTheory": { "type": "string", "maxLength": 16 },
        "sciTheory": { "type": "string", "maxLength": 16 },
        "sscTheory": { "type": "string", "maxLength": 16 },
        "engTheory": { "type": "string", "maxLength": 16 },
        "optTheory": { "type": "string", "maxLength": 16 },
        "vocTheory": { "type": "string", "maxLength": 16 },
        "sciPractical": { "type": "string", "maxLength": 16 },
        "sscLitAct": { "type": "string", "maxLength": 16 },
        "sscPrWork": { "type": "string", "maxLength": 16 },
        "optPractical": { "type": "string", "maxLength": 16 },
        "vocPractical": { "type": "string", "maxLength": 16 }
      },
      "required": [
        "milTheory",
        "silTheory",
        "matTheory",
        "sciTheory",
        "sscTheory",
        "engTheory",
        "optTheory",
        "vocTheory",
        "sciPractical",
        "sscLitAct",
        "sscPrWork",
        "optPractical",
        "vocPractical"
      ]
    },
    "StudentRecord": {
      "title": "StudentRecord",
      "description": "BSEB Admit Card and Sent-Up Marks record owned by a school admin and optionally shared with assigned subject teachers",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serialNo": { "type": "number" },
        "examType": { "type": "string", "enum": ["MATRIC (10th)", "INTERMEDIATE (+2)"], "maxLength": 32 },
        "examYear": { "type": "string", "maxLength": 16 },
        "faculty": { "type": "string", "enum": ["SECONDARY", "ARTS", "SCIENCE", "COMMERCE", "VOCATIONAL"], "maxLength": 32 },
        "bsebUniqueId": { "type": "string", "maxLength": 64 },
        "schoolCode": { "type": "string", "maxLength": 32 },
        "schoolName": { "type": "string", "maxLength": 200 },
        "studentName": { "type": "string", "maxLength": 120 },
        "motherName": { "type": "string", "maxLength": 120 },
        "fatherName": { "type": "string", "maxLength": 120 },
        "dob": { "type": "string", "maxLength": 32 },
        "gender": { "type": "string", "enum": ["MALE", "FEMALE", "OTHER"], "maxLength": 16 },
        "maritalStatus": { "type": "string", "maxLength": 32 },
        "aadhaarNo": { "type": "string", "maxLength": 32 },
        "studentCategory": { "type": "string", "maxLength": 32 },
        "casteCategory": { "type": "string", "maxLength": 32 },
        "differentlyAbled": { "type": "string", "maxLength": 32 },
        "registrationNo": { "type": "string", "maxLength": 64 },
        "rollCode": { "type": "string", "maxLength": 32 },
        "rollNumber": { "type": "string", "maxLength": 32 },
        "examCenter": { "type": "string", "maxLength": 200 },
        "langSubject1": { "type": "string", "maxLength": 80 },
        "langSubject2": { "type": "string", "maxLength": 80 },
        "compulsorySubject1": { "type": "string", "maxLength": 80 },
        "compulsorySubject2": { "type": "string", "maxLength": 80 },
        "compulsorySubject3": { "type": "string", "maxLength": 80 },
        "compulsorySubject4": { "type": "string", "maxLength": 80 },
        "additionalSubject": { "type": "string", "maxLength": 80 },
        "allSubjectsSummary": { "type": "string", "maxLength": 500 },
        "sourceFileName": { "type": "string", "maxLength": 200 },
        "sourcePageNumber": { "type": "number" },
        "extractionMethod": { "type": "string", "maxLength": 32 },
        "interSentUp": { "$ref": "#/entities/InterSentUpMarks", "type": "object" },
        "matricSentUp": { "$ref": "#/entities/MatricSentUpMarks", "type": "object" },
        "assignedTeacherEmails": { "type": "array", "description": "Bounded list (max 30) of lowercase teacher emails authorized to update marks for this student" },
        "assignedClerkEmails": { "type": "array", "description": "Bounded list (max 30) of lowercase clerk emails with strictly read-only print access for this student" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "serialNo",
        "examType",
        "examYear",
        "faculty",
        "bsebUniqueId",
        "schoolCode",
        "schoolName",
        "studentName",
        "motherName",
        "fatherName",
        "dob",
        "gender",
        "maritalStatus",
        "aadhaarNo",
        "studentCategory",
        "casteCategory",
        "differentlyAbled",
        "registrationNo",
        "rollCode",
        "rollNumber",
        "examCenter",
        "langSubject1",
        "langSubject2",
        "compulsorySubject1",
        "compulsorySubject2",
        "compulsorySubject3",
        "compulsorySubject4",
        "additionalSubject",
        "allSubjectsSummary",
        "sourceFileName",
        "sourcePageNumber",
        "extractionMethod",
        "interSentUp",
        "matricSentUp",
        "assignedTeacherEmails",
        "createdAt",
        "updatedAt"
      ]
    },
    "TeacherAssignment": {
      "title": "TeacherAssignment",
      "description": "Maps a teacher Gmail to a School Code, multiple Classes (10th/12th), and multiple Subjects for marks entry",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerEmail": { "type": "string", "maxLength": 160 },
        "teacherName": { "type": "string", "maxLength": 120 },
        "teacherEmail": { "type": "string", "maxLength": 160 },
        "schoolCode": { "type": "string", "maxLength": 32 },
        "schoolName": { "type": "string", "maxLength": 200 },
        "assignedClasses": { "type": "array", "description": "Bounded list (1..2) of ExamType values" },
        "assignedSubjects": { "type": "array", "description": "Bounded list (1..25) of subject names assigned to this teacher" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "ownerEmail",
        "teacherName",
        "teacherEmail",
        "schoolCode",
        "schoolName",
        "assignedClasses",
        "assignedSubjects",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClerkAssignment": {
      "title": "ClerkAssignment",
      "description": "Maps a clerk Gmail to a School Code and Classes (10th/12th) for strictly read-only report printing",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerEmail": { "type": "string", "maxLength": 160 },
        "clerkName": { "type": "string", "maxLength": 120 },
        "clerkEmail": { "type": "string", "maxLength": 160 },
        "schoolCode": { "type": "string", "maxLength": 32 },
        "schoolName": { "type": "string", "maxLength": 200 },
        "assignedClasses": { "type": "array", "description": "Bounded list (1..2) of ExamType values" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "ownerEmail",
        "clerkName",
        "clerkEmail",
        "schoolCode",
        "schoolName",
        "assignedClasses",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "AppFeatureConfig": {
      "title": "AppFeatureConfig",
      "description": "Global Admin feature toggles controlled exclusively by the Super Admin portal (/supadm)",
      "type": "object",
      "properties": {
        "randomMarksGenerator": { "type": "boolean" },
        "excelDownload": { "type": "boolean" },
        "pdfDownload": { "type": "boolean" },
        "completeZipDownload": { "type": "boolean" },
        "letterPadAndLifafa": { "type": "boolean" },
        "attendanceSheet": { "type": "boolean" },
        "teacherClerkManagement": { "type": "boolean" },
        "bulkDeleteData": { "type": "boolean" },
        "updatedByUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "randomMarksGenerator",
        "excelDownload",
        "pdfDownload",
        "completeZipDownload",
        "letterPadAndLifafa",
        "attendanceSheet",
        "teacherClerkManagement",
        "bulkDeleteData",
        "updatedByUid",
        "updatedAt"
      ]
    },
    "AdminFeatureOverride": {
      "title": "AdminFeatureOverride",
      "description": "Per-admin Gmail feature flag override managed exclusively by the Super Admin (/supadm)",
      "type": "object",
      "properties": {
        "adminEmail": { "type": "string", "maxLength": 160 },
        "note": { "type": "string", "maxLength": 200 },
        "randomMarksGenerator": { "type": "boolean" },
        "excelDownload": { "type": "boolean" },
        "pdfDownload": { "type": "boolean" },
        "completeZipDownload": { "type": "boolean" },
        "letterPadAndLifafa": { "type": "boolean" },
        "attendanceSheet": { "type": "boolean" },
        "teacherClerkManagement": { "type": "boolean" },
        "bulkDeleteData": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "adminEmail",
        "note",
        "randomMarksGenerator",
        "excelDownload",
        "pdfDownload",
        "completeZipDownload",
        "letterPadAndLifafa",
        "attendanceSheet",
        "teacherClerkManagement",
        "bulkDeleteData",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminAccount": {
      "title": "AdminAccount",
      "description": "Registry of school admins who signed into the Admin Portal so the Super Admin can configure per-admin feature access",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 160 },
        "displayName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "createdAt",
        "lastLoginAt"
      ]
    },
    "SchoolFeaturePolicy": {
      "title": "SchoolFeaturePolicy",
      "description": "Per-School-Code feature enable/disable policy controlled exclusively by Super Admin (/supadm) and enforced across Admin and Clerk portals",
      "type": "object",
      "properties": {
        "schoolCode": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolName": { "type": "string", "maxLength": 200 },
        "note": { "type": "string", "maxLength": 200 },
        "randomMarksGenerator": { "type": "boolean" },
        "excelDownload": { "type": "boolean" },
        "pdfDownload": { "type": "boolean" },
        "completeZipDownload": { "type": "boolean" },
        "letterPadAndLifafa": { "type": "boolean" },
        "attendanceSheet": { "type": "boolean" },
        "teacherClerkManagement": { "type": "boolean" },
        "bulkDeleteData": { "type": "boolean" },
        "updatedByUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "schoolCode",
        "schoolName",
        "note",
        "randomMarksGenerator",
        "excelDownload",
        "pdfDownload",
        "completeZipDownload",
        "letterPadAndLifafa",
        "attendanceSheet",
        "teacherClerkManagement",
        "bulkDeleteData",
        "updatedByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "SchoolRegistryEntry": {
      "title": "SchoolRegistryEntry",
      "description": "Directory of School Codes registered by signed-in Admins so Super Admin can view all schools, admins, teachers, and clerks and manage features per School Code",
      "type": "object",
      "properties": {
        "schoolCode": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolName": { "type": "string", "maxLength": 200 },
        "adminUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminEmail": { "type": "string", "maxLength": 160 },
        "adminName": { "type": "string", "maxLength": 120 },
        "studentCount": { "type": "number" },
        "teacherCount": { "type": "number" },
        "clerkCount": { "type": "number" },
        "classes": { "type": "array", "description": "Bounded list (0..2) of ExamType values active in this school" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "schoolCode",
        "schoolName",
        "adminUid",
        "adminEmail",
        "adminName",
        "studentCount",
        "teacherCount",
        "clerkCount",
        "classes",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/StudentRecord" },
      "description": "Stores extracted BSEB Admit Card student details and 10th/12th Sent-Up marks scoped to ownerId, authorized assignedTeacherEmails, and read-only assignedClerkEmails."
    },
    "/teacherAssignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/TeacherAssignment" },
      "description": "Stores School Code -> Teacher Email -> Multi-Class & Multi-Subject permissions created by school admins."
    },
    "/clerkAssignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/ClerkAssignment" },
      "description": "Stores School Code -> Clerk Email -> Multi-Class strictly read-only print desk permissions created by school admins."
    },
    "/appFeatureConfig/{configId}": {
      "schema": { "$ref": "#/entities/AppFeatureConfig" },
      "description": "Stores global default Admin feature flags at /appFeatureConfig/global. Readable by verified signed-in users, writable strictly by Super Admin nehajha.gyanora@gmail.com."
    },
    "/adminFeatureOverrides/{overrideId}": {
      "schema": { "$ref": "#/entities/AdminFeatureOverride" },
      "description": "Stores per-admin Gmail feature flag overrides. Readable only by the matching admin email or Super Admin nehajha.gyanora@gmail.com, writable strictly by Super Admin."
    },
    "/adminAccounts/{accountUid}": {
      "schema": { "$ref": "#/entities/AdminAccount" },
      "description": "Stores admin portal login directory entries (PII isolated to self and Super Admin nehajha.gyanora@gmail.com)."
    },
    "/schoolFeaturePolicies/{schoolCodeId}": {
      "schema": { "$ref": "#/entities/SchoolFeaturePolicy" },
      "description": "Stores non-PII per-School-Code feature toggle policies. Single-doc get allowed for verified signed-in users; list and all writes restricted strictly to Super Admin nehajha.gyanora@gmail.com."
    },
    "/schoolRegistry/{entryId}": {
      "schema": { "$ref": "#/entities/SchoolRegistryEntry" },
      "description": "Stores per-Admin School Code directory entries (PII isolated to owning adminUid and Super Admin nehajha.gyanora@gmail.com)."
    }
  }
}
