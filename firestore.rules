rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 256 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.size() >= 3
        && request.auth.token.email.size() <= 160;
    }

    function callerEmail() {
      return request.auth.token.email.lower();
    }

    // Exclusive Super Admin Portal (/supadm) controller
    function isFeatureSuperAdmin() {
      return hasVerifiedEmail() && callerEmail() == 'nehajha.gyanora@gmail.com';
    }

    // Pure token-only super admin check (safe in allow list without get/exists)
    function isSuperAdminEmail() {
      return hasVerifiedEmail()
        && (callerEmail() == 'jhadheeraj97@gmail.com' || callerEmail() == 'nehajha.gyanora@gmail.com');
    }

    function isAdmin() {
      return isSuperAdminEmail()
        || (hasVerifiedEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Pillar 5: Bounded string array guards
    function isValidStringList(arr, minLen, maxLen) {
      return arr is list
        && arr.size() >= minLen
        && arr.size() <= maxLen
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 160));
    }

    // Pillar 2: Compact Validation Blueprints (strictly under Firestore's 1000-expression limit)
    function isValidInterSentUp(m) {
      return m is map
        && m.size() == 20
        && m.keys().hasOnly([
          'lang1Subject', 'lang1Marks', 'lang2Subject', 'lang2Marks',
          'elective1Subject', 'elective1Theory', 'elective1Practical',
          'elective2Subject', 'elective2Theory', 'elective2Practical',
          'elective3Subject', 'elective3Theory', 'elective3Practical',
          'additionalSubject', 'additionalTheory', 'additionalPractical',
          'vocationalSubject', 'vocationalTheory', 'vocationalPractical',
          'resultStatus'
        ])
        && m.lang1Marks is string && m.lang1Marks.size() <= 16
        && m.lang2Marks is string && m.lang2Marks.size() <= 16
        && m.elective1Theory is string && m.elective1Theory.size() <= 16
        && m.elective2Theory is string && m.elective2Theory.size() <= 16
        && m.elective3Theory is string && m.elective3Theory.size() <= 16
        && m.resultStatus is string && m.resultStatus.size() <= 32;
    }

    function isValidMatricSentUp(m) {
      return m is map
        && m.size() == 13
        && m.keys().hasOnly([
          'milTheory', 'silTheory', 'matTheory', 'sciTheory', 'sscTheory',
          'engTheory', 'optTheory', 'vocTheory', 'sciPractical',
          'sscLitAct', 'sscPrWork', 'optPractical', 'vocPractical'
        ])
        && m.milTheory is string && m.milTheory.size() <= 16
        && m.silTheory is string && m.silTheory.size() <= 16
        && m.matTheory is string && m.matTheory.size() <= 16
        && m.sciTheory is string && m.sciTheory.size() <= 16
        && m.sscTheory is string && m.sscTheory.size() <= 16
        && m.engTheory is string && m.engTheory.size() <= 16;
    }

    function isValidStudent(data) {
      return data.keys().hasOnly([
          'ownerId', 'serialNo', 'examType', 'examYear', 'faculty',
          'bsebUniqueId', 'schoolCode', 'schoolName', 'studentName',
          'motherName', 'fatherName', 'dob', 'gender', 'maritalStatus',
          'aadhaarNo', 'studentCategory', 'casteCategory', 'differentlyAbled',
          'registrationNo', 'rollCode', 'rollNumber', 'examCenter',
          'langSubject1', 'langSubject2', 'compulsorySubject1', 'compulsorySubject2',
          'compulsorySubject3', 'compulsorySubject4', 'additionalSubject',
          'allSubjectsSummary', 'sourceFileName', 'sourcePageNumber',
          'extractionMethod', 'interSentUp', 'matricSentUp',
          'assignedTeacherEmails', 'assignedClerkEmails', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_-]+$')
        && data.serialNo is number && data.serialNo >= 0 && data.serialNo <= 100000
        && data.examType in ['MATRIC (10th)', 'INTERMEDIATE (+2)']
        && data.examYear is string && data.examYear.size() <= 16
        && data.faculty in ['SECONDARY', 'ARTS', 'SCIENCE', 'COMMERCE', 'VOCATIONAL']
        && data.schoolCode is string && data.schoolCode.size() <= 32
        && data.schoolName is string && data.schoolName.size() <= 200
        && data.studentName is string && data.studentName.size() <= 120
        && data.motherName is string && data.motherName.size() <= 120
        && data.fatherName is string && data.fatherName.size() <= 120
        && data.gender in ['MALE', 'FEMALE', 'OTHER']
        && data.registrationNo is string && data.registrationNo.size() <= 64
        && data.rollCode is string && data.rollCode.size() <= 32
        && data.rollNumber is string && data.rollNumber.size() <= 32
        && data.allSubjectsSummary is string && data.allSubjectsSummary.size() <= 500
        && data.sourceFileName is string && data.sourceFileName.size() <= 200
        && data.sourcePageNumber is number && data.sourcePageNumber >= 0 && data.sourcePageNumber <= 10000
        && isValidInterSentUp(data.interSentUp)
        && isValidMatricSentUp(data.matricSentUp)
        && (!('assignedTeacherEmails' in data) || isValidStringList(data.assignedTeacherEmails, 0, 30))
        && (!('assignedClerkEmails' in data) || isValidStringList(data.assignedClerkEmails, 0, 30))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTeacherAssignment(data) {
      return data.keys().hasAll([
          'ownerId', 'ownerEmail', 'teacherName', 'teacherEmail',
          'schoolCode', 'schoolName', 'assignedClasses', 'assignedSubjects',
          'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'ownerEmail', 'teacherName', 'teacherEmail',
          'schoolCode', 'schoolName', 'assignedClasses', 'assignedSubjects',
          'active', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_-]+$')
        && data.ownerEmail is string && data.ownerEmail.size() >= 3 && data.ownerEmail.size() <= 160
        && data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 120
        && data.teacherEmail is string && data.teacherEmail.size() >= 3 && data.teacherEmail.size() <= 160
        && data.schoolCode is string && data.schoolCode.size() >= 1 && data.schoolCode.size() <= 32
        && data.schoolName is string && data.schoolName.size() <= 200
        && isValidStringList(data.assignedClasses, 1, 2)
        && isValidStringList(data.assignedSubjects, 1, 25)
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClerkAssignment(data) {
      return data.keys().hasAll([
          'ownerId', 'ownerEmail', 'clerkName', 'clerkEmail',
          'schoolCode', 'schoolName', 'assignedClasses',
          'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'ownerEmail', 'clerkName', 'clerkEmail',
          'schoolCode', 'schoolName', 'assignedClasses',
          'active', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_-]+$')
        && data.ownerEmail is string && data.ownerEmail.size() >= 3 && data.ownerEmail.size() <= 160
        && data.clerkName is string && data.clerkName.size() >= 1 && data.clerkName.size() <= 120
        && data.clerkEmail is string && data.clerkEmail.size() >= 3 && data.clerkEmail.size() <= 160
        && data.schoolCode is string && data.schoolCode.size() >= 1 && data.schoolCode.size() <= 32
        && data.schoolName is string && data.schoolName.size() <= 200
        && isValidStringList(data.assignedClasses, 1, 2)
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFeatureFlagsFields(data) {
      return data.randomMarksGenerator is bool
        && data.excelDownload is bool
        && data.pdfDownload is bool
        && data.completeZipDownload is bool
        && data.letterPadAndLifafa is bool
        && data.attendanceSheet is bool
        && data.teacherClerkManagement is bool
        && data.bulkDeleteData is bool;
    }

    function isValidAppFeatureConfig(data) {
      return data.keys().hasAll([
          'randomMarksGenerator', 'excelDownload', 'pdfDownload',
          'completeZipDownload', 'letterPadAndLifafa', 'attendanceSheet',
          'teacherClerkManagement', 'bulkDeleteData', 'updatedByUid', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'randomMarksGenerator', 'excelDownload', 'pdfDownload',
          'completeZipDownload', 'letterPadAndLifafa', 'attendanceSheet',
          'teacherClerkManagement', 'bulkDeleteData', 'updatedByUid', 'updatedAt'
        ])
        && isValidFeatureFlagsFields(data)
        && data.updatedByUid is string
        && data.updatedByUid.size() >= 1
        && data.updatedByUid.size() <= 128
        && data.updatedByUid.matches('^[a-zA-Z0-9_-]+$')
        && data.updatedAt is timestamp;
    }

    function isValidAdminFeatureOverride(data) {
      return data.keys().hasAll([
          'adminEmail', 'note',
          'randomMarksGenerator', 'excelDownload', 'pdfDownload',
          'completeZipDownload', 'letterPadAndLifafa', 'attendanceSheet',
          'teacherClerkManagement', 'bulkDeleteData',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'adminEmail', 'note',
          'randomMarksGenerator', 'excelDownload', 'pdfDownload',
          'completeZipDownload', 'letterPadAndLifafa', 'attendanceSheet',
          'teacherClerkManagement', 'bulkDeleteData',
          'createdAt', 'updatedAt'
        ])
        && data.adminEmail is string
        && data.adminEmail.size() >= 3
        && data.adminEmail.size() <= 160
        && data.note is string
        && data.note.size() <= 200
        && isValidFeatureFlagsFields(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'lastLoginAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'lastLoginAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_-]+$')
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function isValidSchoolFeaturePolicy(data) {
      return data.keys().hasAll([
          'schoolCode', 'schoolName', 'note',
          'randomMarksGenerator', 'excelDownload', 'pdfDownload',
          'completeZipDownload', 'letterPadAndLifafa', 'attendanceSheet',
          'teacherClerkManagement', 'bulkDeleteData',
          'updatedByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'schoolCode', 'schoolName', 'note',
          'randomMarksGenerator', 'excelDownload', 'pdfDownload',
          'completeZipDownload', 'letterPadAndLifafa', 'attendanceSheet',
          'teacherClerkManagement', 'bulkDeleteData',
          'updatedByUid', 'createdAt', 'updatedAt'
        ])
        && data.schoolCode is string
        && data.schoolCode.size() >= 1
        && data.schoolCode.size() <= 32
        && data.schoolCode.matches('^[a-zA-Z0-9_-]+$')
        && data.schoolName is string
        && data.schoolName.size() <= 200
        && data.note is string
        && data.note.size() <= 200
        && isValidFeatureFlagsFields(data)
        && data.updatedByUid is string
        && data.updatedByUid.size() >= 1
        && data.updatedByUid.size() <= 128
        && data.updatedByUid.matches('^[a-zA-Z0-9_-]+$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSchoolRegistry(data) {
      return data.keys().hasAll([
          'schoolCode', 'schoolName', 'adminUid', 'adminEmail', 'adminName',
          'studentCount', 'teacherCount', 'clerkCount', 'classes',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'schoolCode', 'schoolName', 'adminUid', 'adminEmail', 'adminName',
          'studentCount', 'teacherCount', 'clerkCount', 'classes',
          'createdAt', 'updatedAt'
        ])
        && data.schoolCode is string
        && data.schoolCode.size() >= 1
        && data.schoolCode.size() <= 32
        && data.schoolCode.matches('^[a-zA-Z0-9_-]+$')
        && data.schoolName is string
        && data.schoolName.size() <= 200
        && data.adminUid is string
        && data.adminUid.size() >= 1
        && data.adminUid.size() <= 128
        && data.adminUid.matches('^[a-zA-Z0-9_-]+$')
        && data.adminEmail is string
        && data.adminEmail.size() >= 3
        && data.adminEmail.size() <= 160
        && data.adminName is string
        && data.adminName.size() <= 120
        && data.studentCount is number && data.studentCount >= 0 && data.studentCount <= 100000
        && data.teacherCount is number && data.teacherCount >= 0 && data.teacherCount <= 1000
        && data.clerkCount is number && data.clerkCount >= 0 && data.clerkCount <= 1000
        && isValidStringList(data.classes, 0, 2)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isStudentAssignedTeacher(res) {
      return hasVerifiedEmail()
        && 'assignedTeacherEmails' in res
        && res.assignedTeacherEmails is list
        && (
          request.auth.token.email in res.assignedTeacherEmails
          || callerEmail() in res.assignedTeacherEmails
        );
    }

    function isStudentAssignedClerk(res) {
      return hasVerifiedEmail()
        && 'assignedClerkEmails' in res
        && res.assignedClerkEmails is list
        && (
          request.auth.token.email in res.assignedClerkEmails
          || callerEmail() in res.assignedClerkEmails
        );
    }

    match /students/{studentId} {
      allow get: if hasVerifiedEmail()
        && isValidId(studentId)
        && (
          resource == null
          || resource.data.ownerId == request.auth.uid
          || isStudentAssignedTeacher(resource.data)
          || isStudentAssignedClerk(resource.data)
          || isAdmin()
        );

      // Pillar 8: Zero get()/exists() in allow list; strictly enforces resource.data boundaries
      allow list: if hasVerifiedEmail()
        && (
          resource.data.ownerId == request.auth.uid
          || request.auth.token.email in resource.data.assignedTeacherEmails
          || callerEmail() in resource.data.assignedTeacherEmails
          || request.auth.token.email in resource.data.assignedClerkEmails
          || callerEmail() in resource.data.assignedClerkEmails
          || isSuperAdminEmail()
        );

      // Clerks strictly cannot create, update, or delete student records
      allow create: if hasVerifiedEmail()
        && isValidId(studentId)
        && isValidStudent(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Pillar 4: Tiered Action-Based Update (Admin/Owner vs Assigned Teacher Marks-Only; Clerks are strictly Read-Only)
      allow update: if hasVerifiedEmail()
        && isValidId(studentId)
        && isValidStudent(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          ('createdAt' in resource.data && resource.data.createdAt is timestamp && request.resource.data.createdAt == resource.data.createdAt)
          || (!('createdAt' in resource.data && resource.data.createdAt is timestamp) && request.resource.data.createdAt == request.time)
        )
        && request.resource.data.updatedAt == request.time
        && (
          // Tier 1: Owner or Admin full record update (strictly schema-bounded by isValidStudent above)
          resource.data.ownerId == request.auth.uid
          || isAdmin()
          ||
          // Tier 2: Assigned Teacher restricted strictly to Marks entry fields
          (
            isStudentAssignedTeacher(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'interSentUp', 'matricSentUp', 'updatedAt'
            ])
          )
        );

      allow delete: if hasVerifiedEmail()
        && isValidId(studentId)
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /teacherAssignments/{assignmentId} {
      // Pillar 6: PII Isolation - only creating school admin, the assigned teacher themselves, or super admin
      allow get: if hasVerifiedEmail()
        && isValidId(assignmentId)
        && (
          resource == null
          || resource.data.ownerId == request.auth.uid
          || resource.data.teacherEmail == request.auth.token.email
          || resource.data.teacherEmail == callerEmail()
          || isAdmin()
        );

      // Pillar 8: Zero get()/exists() in allow list
      allow list: if hasVerifiedEmail()
        && (
          resource.data.ownerId == request.auth.uid
          || resource.data.teacherEmail == request.auth.token.email
          || resource.data.teacherEmail == callerEmail()
          || isSuperAdminEmail()
        );

      allow create: if hasVerifiedEmail()
        && isValidId(assignmentId)
        && isValidTeacherAssignment(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if hasVerifiedEmail()
        && isValidId(assignmentId)
        && isValidTeacherAssignment(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (resource.data.ownerId == request.auth.uid || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerEmail', 'teacherName', 'teacherEmail', 'schoolCode',
          'schoolName', 'assignedClasses', 'assignedSubjects', 'active', 'updatedAt'
        ]);

      allow delete: if hasVerifiedEmail()
        && isValidId(assignmentId)
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /clerkAssignments/{assignmentId} {
      // Pillar 6: PII Isolation - only creating school admin, the assigned clerk themselves, or super admin
      allow get: if hasVerifiedEmail()
        && isValidId(assignmentId)
        && (
          resource == null
          || resource.data.ownerId == request.auth.uid
          || resource.data.clerkEmail == request.auth.token.email
          || resource.data.clerkEmail == callerEmail()
          || isAdmin()
        );

      // Pillar 8: Zero get()/exists() in allow list
      allow list: if hasVerifiedEmail()
        && (
          resource.data.ownerId == request.auth.uid
          || resource.data.clerkEmail == request.auth.token.email
          || resource.data.clerkEmail == callerEmail()
          || isSuperAdminEmail()
        );

      allow create: if hasVerifiedEmail()
        && isValidId(assignmentId)
        && isValidClerkAssignment(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if hasVerifiedEmail()
        && isValidId(assignmentId)
        && isValidClerkAssignment(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (resource.data.ownerId == request.auth.uid || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerEmail', 'clerkName', 'clerkEmail', 'schoolCode',
          'schoolName', 'assignedClasses', 'active', 'updatedAt'
        ]);

      allow delete: if hasVerifiedEmail()
        && isValidId(assignmentId)
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /appFeatureConfig/{configId} {
      // Non-PII global boolean feature flags document ('global') readable by verified signed-in users
      allow get: if hasVerifiedEmail()
        && isValidId(configId)
        && configId == 'global';

      allow list: if false;

      allow create: if isFeatureSuperAdmin()
        && isValidId(configId)
        && configId == 'global'
        && isValidAppFeatureConfig(request.resource.data)
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow update: if isFeatureSuperAdmin()
        && isValidId(configId)
        && configId == 'global'
        && isValidAppFeatureConfig(request.resource.data)
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'randomMarksGenerator', 'excelDownload', 'pdfDownload',
          'completeZipDownload', 'letterPadAndLifafa', 'attendanceSheet',
          'teacherClerkManagement', 'bulkDeleteData', 'updatedByUid', 'updatedAt'
        ]);

      allow delete: if isFeatureSuperAdmin()
        && isValidId(configId);
    }

    match /adminFeatureOverrides/{overrideId} {
      // Pillar 6: PII Isolation - only the targeted admin email or Super Admin nehajha.gyanora@gmail.com
      allow get: if hasVerifiedEmail()
        && isValidId(overrideId)
        && (
          resource == null
          || resource.data.adminEmail == callerEmail()
          || isFeatureSuperAdmin()
        );

      // Pillar 8: Zero get()/exists() in allow list
      allow list: if hasVerifiedEmail()
        && (
          resource.data.adminEmail == callerEmail()
          || isFeatureSuperAdmin()
        );

      allow create: if isFeatureSuperAdmin()
        && isValidId(overrideId)
        && isValidAdminFeatureOverride(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isFeatureSuperAdmin()
        && isValidId(overrideId)
        && isValidAdminFeatureOverride(request.resource.data)
        && request.resource.data.adminEmail == resource.data.adminEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'note', 'randomMarksGenerator', 'excelDownload', 'pdfDownload',
          'completeZipDownload', 'letterPadAndLifafa', 'attendanceSheet',
          'teacherClerkManagement', 'bulkDeleteData', 'updatedAt'
        ]);

      allow delete: if isFeatureSuperAdmin()
        && isValidId(overrideId);
    }

    match /adminAccounts/{accountUid} {
      // Pillar 6: PII Isolation - admin can only read/write own profile; only Super Admin can list all admins
      allow get: if hasVerifiedEmail()
        && isValidId(accountUid)
        && (accountUid == request.auth.uid || isFeatureSuperAdmin());

      allow list: if isFeatureSuperAdmin();

      allow create: if hasVerifiedEmail()
        && isValidId(accountUid)
        && accountUid == request.auth.uid
        && isValidAdminAccount(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == callerEmail()
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;

      allow update: if hasVerifiedEmail()
        && isValidId(accountUid)
        && accountUid == request.auth.uid
        && isValidAdminAccount(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == callerEmail()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastLoginAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'lastLoginAt'
        ]);

      allow delete: if isFeatureSuperAdmin()
        && isValidId(accountUid);
    }

    match /schoolFeaturePolicies/{schoolCodeId} {
      // Zero PII: per-School-Code boolean feature toggles; single-doc get by known code for Admin/Clerk, list strictly Super Admin
      allow get: if hasVerifiedEmail()
        && isValidId(schoolCodeId);

      // Pillar 8: Zero get()/exists() in allow list
      allow list: if isFeatureSuperAdmin();

      allow create: if isFeatureSuperAdmin()
        && isValidId(schoolCodeId)
        && isValidSchoolFeaturePolicy(request.resource.data)
        && request.resource.data.schoolCode == schoolCodeId
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isFeatureSuperAdmin()
        && isValidId(schoolCodeId)
        && isValidSchoolFeaturePolicy(request.resource.data)
        && request.resource.data.schoolCode == resource.data.schoolCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'schoolName', 'note', 'randomMarksGenerator', 'excelDownload', 'pdfDownload',
          'completeZipDownload', 'letterPadAndLifafa', 'attendanceSheet',
          'teacherClerkManagement', 'bulkDeleteData', 'updatedByUid', 'updatedAt'
        ]);

      allow delete: if isFeatureSuperAdmin()
        && isValidId(schoolCodeId);
    }

    match /schoolRegistry/{entryId} {
      // Pillar 6: PII Isolation - only owning adminUid or Super Admin nehajha.gyanora@gmail.com
      allow get: if hasVerifiedEmail()
        && isValidId(entryId)
        && (
          resource == null
          || resource.data.adminUid == request.auth.uid
          || isFeatureSuperAdmin()
        );

      // Pillar 8: Zero get()/exists() in allow list
      allow list: if hasVerifiedEmail()
        && (
          resource.data.adminUid == request.auth.uid
          || isFeatureSuperAdmin()
        );

      allow create: if hasVerifiedEmail()
        && isValidId(entryId)
        && isValidSchoolRegistry(request.resource.data)
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.adminEmail == callerEmail()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if hasVerifiedEmail()
        && isValidId(entryId)
        && isValidSchoolRegistry(request.resource.data)
        && resource.data.adminUid == request.auth.uid
        && request.resource.data.adminUid == resource.data.adminUid
        && request.resource.data.schoolCode == resource.data.schoolCode
        && request.resource.data.adminEmail == callerEmail()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'schoolName', 'adminEmail', 'adminName', 'studentCount',
          'teacherCount', 'clerkCount', 'classes', 'updatedAt'
        ]);

      allow delete: if hasVerifiedEmail()
        && isValidId(entryId)
        && (resource.data.adminUid == request.auth.uid || isFeatureSuperAdmin());
    }
  }
}
